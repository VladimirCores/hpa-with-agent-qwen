# =============================================================================
# Talos Cluster Configuration Template
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# DO NOT commit .env to version control if it contains sensitive data.
# =============================================================================

# Network Configuration
NETWORK_NAME=cluster-talos-net
BRIDGE_NAME=talos-bridge
NETWORK_CIDR=10.0.0.1/24
NETWORK_IP=10.0.0.1
NETWORK_MASK=255.255.255.0
DHCP_START=10.0.0.2
DHCP_END=10.0.0.254
FORWARD_MODE=nat

# Storage Configuration
STORAGE_POOL=talos-pool
POOL_PATH=/var/lib/libvirt/talos-pool

# Talos Disk Image Configuration
# NOTE: Talos v1.12.x has a known bootstrap bug (CA mismatch).
# Use v1.11.5 until fixed: https://github.com/siderolabs/talos/issues
TALOS_IMAGE_URL=https://github.com/siderolabs/talos/releases/download/v1.11.5/metal-amd64.iso
TALOS_IMAGE_PATH=./metal-amd64.iso
TALOS_IMAGE_VOLUME=talos-metal-amd64

# Vagrant Box Configuration (optional - for reusable boxes)
# Set USE_BOX=true to use a pre-built Vagrant box instead of ISO
# Create box with: ./scripts/create-talos-box.sh
USE_BOX=false
BOX_NAME=talos
BOX_VERSION=1.11.5

# Master Node Configuration
MASTER_NAME=talos-master
MASTER_IP=10.0.0.10
MASTER_CPUS=4
MASTER_MEMORY=4096
MASTER_DISK=50

# Worker Nodes Configuration
WORKER_COUNT=2
WORKER_NAME_PREFIX=talos-worker-
WORKER_IP_BASE=10.0.0.11
WORKER_CPUS=1
WORKER_MEMORY=2048
WORKER_DISK=20

# VM Configuration
VM_BOX=generic/alpine319
LIBVIRT_URI=qemu:///system
ROOT_PASSWORD=123
CLUSTER_NAME=talos-cluster

# MAC Address Prefix
MAC_PREFIX=52:54:00:00:00

# Vagrant Configuration
VAGRANT_SKIP_PREFLIGHT=false
