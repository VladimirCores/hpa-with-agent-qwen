# =============================================================================
# Talos Cluster Configuration Template
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# DO NOT commit .env to version control if it contains sensitive data.
# =============================================================================

# Network Configuration
NETWORK_NAME=talos-net
BRIDGE_NAME=talos-bridge
NETWORK_CIDR=10.0.0.1/24
NETWORK_IP=10.0.0.1
NETWORK_MASK=255.255.255.0
DHCP_START=10.0.0.2
DHCP_END=10.0.0.254
FORWARD_MODE=nat

# Storage Configuration
# Storage pool location options:
# - System mode default: /var/lib/libvirt/talos-pool (requires sudo)
# - Session mode default: $HOME/.local/share/libvirt/talos-pool
# - Project-local (recommended): ./.vagrant/storage-pool (portable, no sudo)

STORAGE_POOL=talos-pool
# Uncomment to use project-local storage (works for both system and session mode):
POOL_PATH=$PROJECT_ROOT/.vagrant/storage-pool

# Vagrant Box Configuration (optional - for reusable boxes)
# Set USE_BOX=true to use a pre-built Vagrant box instead of ISO
# Create box with: ./scripts/create-talos-box.sh
USE_BOX=false
BOX_NAME=talos
BOX_VERSION=1.12.6

# Talos Disk Image Configuration
# Use BOX_VERSION to control the Talos version for all image URLs
# Option A: ISO-based installation (traditional)
TALOS_IMAGE_URL=https://github.com/siderolabs/talos/releases/download/v${BOX_VERSION}/metal-amd64.iso
TALOS_IMAGE_PATH=./metal-amd64.iso
TALOS_IMAGE_VOLUME=talos-metal-amd64

# Option B: Raw disk image (faster provisioning, recommended)
# Download compressed raw image and decompress for direct disk usage
TALOS_RAW_IMAGE_URL=https://github.com/siderolabs/talos/releases/download/v${BOX_VERSION}/metal-amd64.raw.zst
TALOS_RAW_IMAGE_PATH=./metal-amd64.raw
TALOS_RAW_IMAGE_COMPRESSED=./metal-amd64.raw.zst
USE_RAW_IMAGE=true

# Master Node Configuration
MASTER_NAME=talos-master
MASTER_IP=10.0.0.10
MASTER_CPUS=4
MASTER_MEMORY=4096
MASTER_DISK=50  # Disk size in GB for Talos installation

# Worker Nodes Configuration
WORKER_COUNT=2
WORKER_NAME_PREFIX=talos-worker-
WORKER_IP_BASE=10.0.0.11
WORKER_CPUS=2
WORKER_MEMORY=2048
WORKER_DISK=20  # Disk size in GB for Talos installation

# VM Configuration
VM_BOX=generic/alpine319

# Libvirt Configuration
# User session mode (REQUIRED - VMs run in user space)
# No sudo required, storage in project folder
LIBVIRT_URI=qemu:///session

# System mode is NOT supported for this setup
# LIBVIRT_URI=qemu:///system  # Do not use

# Storage Configuration for Session Mode (if using qemu:///session)
# SESSION_STORAGE_POOL=talos-pool
# SESSION_POOL_PATH=$HOME/.local/share/libvirt/talos-pool

ROOT_PASSWORD=123
CLUSTER_NAME=talos-cluster

# MAC Address Prefix
MAC_PREFIX=52:54:00:00:00

# Vagrant Configuration
VAGRANT_SKIP_PREFLIGHT=false

# Kubernetes Components Versions
CILIUM_VERSION="1.19.1"
CALICO_VERSION="3.28.0"
FLANNEL_VERSION="latest"
METRICS_SERVER_VERSION="0.7.1"
