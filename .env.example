# =============================================================================
# Talos Cluster Configuration Template
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# DO NOT commit .env to version control if it contains sensitive data.
# =============================================================================

# Network Configuration
NETWORK_NAME=cluster-net
BRIDGE_NAME=cluster-bridge
NETWORK_CIDR=192.168.123.1/24
NETWORK_IP=192.168.123.1
NETWORK_MASK=255.255.255.0
DHCP_START=192.168.123.2
DHCP_END=192.168.123.254

# Forward mode options:
# - 'nat' (recommended): Uses libvirt NAT with DHCP, requires polkit for session mode
# - 'bridge': Uses existing bridge interface, NO DHCP (VMs need external DHCP or static config)
# For static IP reservations, use 'nat' mode with polkit configuration
FORWARD_MODE=nat

# Storage Configuration
# Storage pool location options:
# - System mode default: /var/lib/libvirt/talos-pool (requires sudo)
# - Session mode default: $HOME/.local/share/libvirt/talos-pool
# - Project-local (recommended): ./.vagrant/storage-pool (portable, no sudo)

STORAGE_POOL=talos-pool
# POOL_PATH is auto-calculated by scripts (project-local by default)
# Uncomment to override:
# POOL_PATH=$HOME/.vagrant/storage-pool

# Talos Version (used for config generation and bootstrap)
# Must match the version installed on the VMs
TALOS_VERSION=v1.13

# Vagrant Box Configuration (optional - for reusable boxes)
# Set USE_BOX=true to use a pre-built Vagrant box instead of ISO
# Create box with: ./scripts/create-talos-box.sh
USE_BOX=false
BOX_NAME=talos
BOX_VERSION=1.13.0

# Talos Disk Image Configuration
# Use BOX_VERSION to control the Talos version for all image URLs
# Option A: ISO-based installation (traditional)
TALOS_IMAGE_URL=https://github.com/siderolabs/talos/releases/download/v${BOX_VERSION}/metal-amd64.iso
TALOS_IMAGE_PATH=./metal-amd64.iso
TALOS_IMAGE_VOLUME=talos-metal-amd64

# Option B: Raw disk image (faster provisioning, recommended)
# Download compressed raw image and decompress for direct disk usage
TALOS_RAW_IMAGE_URL=https://github.com/siderolabs/talos/releases/download/v${BOX_VERSION}/metal-amd64.raw.zst
TALOS_RAW_IMAGE_PATH=./metal-amd64.raw
TALOS_RAW_IMAGE_COMPRESSED=./metal-amd64.raw.zst
USE_RAW_IMAGE=true

# Master Node Configuration
MASTER_NAME=talos-master
MASTER_IP=192.168.123.10
MASTER_CPUS=4
MASTER_MEMORY=6144
MASTER_DISK=20  # Disk size in GB for Talos installation

# Worker Nodes Configuration
WORKER_COUNT=2
WORKER_NAME_PREFIX=talos-worker-
WORKER_IP_BASE=192.168.123.20
WORKER_CPUS=2
WORKER_MEMORY=2048
WORKER_DISK=10  # Disk size in GB for Talos installation

# VM Configuration
VM_BOX=generic/alpine319

# Libvirt Configuration
# System mode (default - recommended for bridge mode with dnsmasq)
# Requires polkit rules or libvirt group membership
LIBVIRT_URI=qemu:///system

# Session mode alternative (user space, no sudo for VM operations)
# LIBVIRT_URI=qemu:///session  # Uncomment to use session mode

# Sudo Configuration
# If set, scripts will use this password for sudo commands automatically
# This prevents interactive sudo prompts during startup/bootstrap
# Leave empty to use normal sudo (will prompt for password when needed)
SUDO_PASSWORD=

# Storage Configuration for Session Mode (if using qemu:///session)
# SESSION_STORAGE_POOL=talos-pool
# SESSION_POOL_PATH=$HOME/.local/share/libvirt/talos-pool

ROOT_PASSWORD="<CHANGE_ME_SECURE_PASSWORD>"
CLUSTER_NAME=talos-cluster

# MAC Address Prefix
MAC_PREFIX=52:54:00:00:00

# Vagrant Configuration
VAGRANT_SKIP_PREFLIGHT=false

# Kubernetes Components Versions
CILIUM_VERSION="1.19.1"
CALICO_VERSION="3.28.0"
FLANNEL_VERSION="latest"
METRICS_SERVER_VERSION="0.7.1"

# Component enable/disable flags
# Set to false to skip image caching for optional components
CILIUM_ENABLED=true
CALICO_ENABLED=false
FLANNEL_ENABLED=false
METRICS_SERVER_ENABLED=true
METALLB_ENABLED=true
DASHBOARD_ENABLED=false
ISTIO_ENABLED=false
ENVOY_GATEWAY_ENABLED=false
INFISICAL_ENABLED=false

# Hubble - Network observability (bundled with Cilium)
# When disabled, Hubble is not installed even with CILIUM_ENABLED=true
HUBBLE_ENABLED=true

# Kiali - Service mesh visualization (requires ISTIO_ENABLED=true)
KIALA_ENABLED=false

# =============================================================================
# Cilium CNI Configuration
# =============================================================================
# Cilium provides eBPF-based pod networking with kube-proxy replacement.
# Hubble provides network observability (bundled with Cilium).
# =============================================================================

# Disable kube-proxy (Cilium replaces it with BPF-based service routing)
# Default: true (kube-proxy disabled, Cilium handles service routing)
# Set to false to keep kube-proxy running alongside Cilium
CILIUM_KUBE_PROXY_REPLACEMENT=true

# Hubble UI - Network observability
# Default: true (Hubble UI enabled for network flow monitoring)
# Set to false to disable Hubble and reduce resource usage
HUBBLE_ENABLED=true

# Hubble Relay - gRPC API for Hubble data
# Required for Hubble UI and CLI
CILIUM_HUBBLE_RELAY_ENABLED=true

# =============================================================================
# MetalLB LoadBalancer Configuration
# =============================================================================
# MetalLB provides LoadBalancer-type Services for bare-metal clusters.
# Required for Envoy Gateway and external traffic ingress.
# =============================================================================

# MetalLB Version (Helm chart version)
METALLB_VERSION=0.14.8

# Installation method: 'helm' (recommended) or 'manifest'
METALLB_INSTALL_METHOD=helm

# IP Address Pool Configuration
# These IPs must be in the same subnet as cluster nodes and unused.
# Range should not overlap with DHCP reservations (MASTER_IP, WORKER IPs).
METALLB_IP_POOL_NAME=default-pool
METALLB_IP_POOL_START=192.168.123.200
METALLB_IP_POOL_END=192.168.123.250

# MetalLB Mode: 'l2' (Layer 2 ARP) or 'bgp' (BGP routing)
# L2 mode: Simple, works with NAT/bridged networks, one node active at a time
# BGP mode: ECMP load distribution, requires BGP-capable router
METALLB_MODE=l2

# L2 Advertisement Settings (for L2 mode)
# Limit advertisement to specific network interfaces (leave empty for all)
METALLB_L2_INTERFACES=
# Restrict to nodes with specific labels (leave empty for all nodes)
METALLB_L2_NODE_SELECTOR=

# BGP Settings (for BGP mode)
METALLB_BGP_MY_ASN=64512
METALLB_BGP_PEER_ASN=64512
METALLB_BGP_PEER_ADDRESS=
METALLB_BGP_PEER_PORT=179

# Advanced Settings
# Skip .0 and .255 IPs to avoid network equipment conflicts
METALLB_AVOID_BUGGY_IPS=true
# Auto-assign IPs to new LoadBalancer Services (false = manual annotation)
METALLB_AUTO_ASSIGN=true

# Envoy Gateway Integration
# Reserve IP for Envoy Gateway (optional, leave empty for dynamic assignment)
# This IP will be excluded from the general pool and get dedicated IPAddressPool
ENVOY_GATEWAY_LB_IP=

# =============================================================================
# Expose Internal Services via MetalLB LoadBalancer
# =============================================================================
# These options create LoadBalancer Services for internal cluster UIs.
# Makes them accessible via stable external IPs without port-forwarding.
# =============================================================================

# Expose Hubble UI via MetalLB LoadBalancer
# Default: true (Hubble UI gets dedicated LoadBalancer IP)
EXPOSE_HUBBLE_UI=true
# Optional: Assign specific IP (leave empty for auto-assignment from pool)
HUBBLE_UI_LB_IP=

# Expose Kubernetes Dashboard via MetalLB LoadBalancer
# Default: true (Dashboard gets dedicated LoadBalancer IP)
EXPOSE_K8S_DASHBOARD=true
# Optional: Assign specific IP (leave empty for auto-assignment from pool)
K8S_DASHBOARD_LB_IP=

# =============================================================================
# Cluster Health Monitor Configuration
# =============================================================================
# Configuration for the cluster health monitoring script.
# Provides continuous monitoring of cluster health and alerts on issues.
# =============================================================================

# Health check interval in seconds (default: 60)
CHECK_INTERVAL=60

# Enable background monitoring after bootstrap (default: false)
AUTO_START_MONITOR=false

# Log file for health monitor (leave empty for stdout only)
MONITOR_LOG_FILE=

# =============================================================================
# Bootstrap Timeout Configuration
# =============================================================================
# Control timeout values for various bootstrap operations.
# Increase these values if your environment is slower.
# =============================================================================

# Maximum time to wait for complete bootstrap (seconds, default: 600)
MAX_BOOTSTRAP_TIME=600

# Maximum time to wait for pods to be ready (seconds, default: 300)
MAX_POD_READY_TIME=300

# Number of retry attempts for unstable pods (default: 3)
MAX_POD_RETRY_ATTEMPTS=3

# Delay between pod restart retries (seconds, default: 30)
POD_RETRY_DELAY=30

# =============================================================================
# Backup Configuration
# =============================================================================
# Settings for automatic configuration backups during bootstrap.
# Backups are stored in talos-cluster/backups/YYYYMMDD_HHMMSS/
# =============================================================================

# Enable automatic backup after bootstrap (default: true)
AUTO_BACKUP_ENABLED=true

# Number of backups to retain (default: 10)
BACKUP_RETENTION_COUNT=10

# =============================================================================
# Advanced Options
# =============================================================================
# These options are for advanced users and specific use cases.
# Modify with caution and understanding of implications.
# =============================================================================

# Skip VM preflight checks (not recommended)
VAGRANT_SKIP_PREFLIGHT=false

# Use raw disk image for faster provisioning (default: true)
USE_RAW_IMAGE=true

# Debug mode - enables verbose logging in scripts
DEBUG_MODE=false

# Custom talosctl endpoint (default: MASTER_IP)
TALOS_ENDPOINT=

# Additional kernel modules to load on nodes (comma-separated)
KERNEL_MODULES=

# Custom CNI configuration file path (leave empty for defaults)
CUSTOM_CNI_CONFIG=
