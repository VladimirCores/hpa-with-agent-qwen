Vagrant.configure("2") do |config|
  config.vm.box = "generic/empty"
  config.vm.provider :libvirt do |domain|
    domain.memory = 2048
    domain.cpus = 2
    domain.storage :file, device: :cdrom, path: "/home/cores/Documents/Projects/Study/HPA/with-agent-qwen/metal-amd64.iso"
    domain.boot 'cdrom'
    domain.boot 'hd'
    domain.storage :file, size: '5G', bus: 'virtio'
  end
end
